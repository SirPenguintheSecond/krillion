export default async function handler(req, res) {
  if (req.method !== "POST") {
    return res.status(405).json({ error: "Method not allowed" });
  }

  const { answer, prompt, topic } = req.body || {};
  if (!answer || !prompt) {
    return res.status(400).json({ error: "Missing answer or prompt" });
  }

  const apiKey = process.env.GEMINI_API_KEY;
  if (!apiKey) {
    // Signal client to fall back to client key or Live Wikipedia Deep Research
    return res.status(503).json({ fallback: true });
  }

  const systemInstruction = `You are the official rarity and deep-research judge for Krillion.io (Abyssal Edition).
Prompt: "${prompt}" (Category: ${topic})
Player's Submitted Answer: "${answer}"

1. Verify whether "${answer}" is factually a real, accurate answer that fits "${prompt}". Allow minor spelling variations.
2. If valid, classify how niche it is into one of these exact 7 tier keys:
- "plankton": Really obvious, household answer (10 pts)
- "too_clever": Pretty obvious, predictable "clever" choice (15 pts)
- "schooler": Pretty niche, solid knowledge (30 pts)
- "rare": Niche, genuinely uncommon (60 pts)
- "deep_cut": Very niche, specialist or historical knowledge (85 pts)
- "krillion": Dumb niche, barely anyone has ever heard of it (100 pts)
- "bakrillion": Essentially completely unknown abyssal anomaly requiring deep research to confirm (150 pts)

Respond ONLY in valid JSON:
{
  "valid": boolean,
  "canonicalName": "Properly capitalized name of entity",
  "tier": "plankton" | "too_clever" | "schooler" | "rare" | "deep_cut" | "krillion" | "bakrillion",
  "explanation": "1 concise sentence explaining the entity and why it earned this rarity tier (or why it was refused)."
}`;

  try {
    const response = await fetch(
      `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${apiKey}`,
      {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          contents: [{ parts: [{ text: systemInstruction }] }],
          generationConfig: { responseMimeType: "application/json" }
        })
      }
    );

    const data = await response.json();
    const rawJson = data?.candidates?.[0]?.content?.parts?.[0]?.text;
    if (!rawJson) {
      return res.status(503).json({ fallback: true });
    }

    return res.status(200).json(JSON.parse(rawJson));
  } catch (err) {
    return res.status(503).json({ fallback: true, error: err.message });
  }
}
